{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sister.local/contracts/atmos/climate_analysis.schema.json",
  "title": "SisTer Atmos Climate Analysis",
  "type": "object",
  "required": [
    "analysis_id",
    "requested_product",
    "used_product",
    "requested_period",
    "effective_period",
    "complete",
    "available_days",
    "missing_dates",
    "summary",
    "daily",
    "provenance"
  ],
  "properties": {
    "analysis_id": { "type": "string", "minLength": 1 },
    "requested_product": { "type": "string", "minLength": 1 },
    "used_product": { "type": "string", "minLength": 1 },
    "requested_period": { "$ref": "#/$defs/period" },
    "effective_period": { "$ref": "#/$defs/period" },
    "complete": { "type": "boolean" },
    "available_days": { "type": "integer", "minimum": 1 },
    "missing_dates": {
      "type": "array",
      "items": { "type": "string", "format": "date" }
    },
    "summary": {
      "type": "object",
      "required": ["total_mm", "maximum_daily_mm", "mean_daily_mm", "rainy_days"],
      "properties": {
        "total_mm": { "type": "number", "minimum": 0 },
        "maximum_daily_mm": { "type": "number", "minimum": 0 },
        "mean_daily_mm": { "type": "number", "minimum": 0 },
        "rainy_days": { "type": "integer", "minimum": 0 }
      }
    },
    "daily": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "precipitation_mm", "accumulated_mm"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "precipitation_mm": { "type": "number", "minimum": 0 },
          "accumulated_mm": { "type": "number", "minimum": 0 }
        }
      }
    },
    "provenance": { "type": "object" }
  },
  "$defs": {
    "period": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" }
      }
    }
  }
}
