{
  "schema": "sister.component/1.0.0",
  "component_id": "atmos",
  "system_id": "sister_atmos",
  "deployment_role": "system",
  "semantic_contract": "sister.subsystem/1.0.0",
  "build": {
    "driver": "cmake-ninja/1",
    "source": ".",
    "build_dir": "build",
    "configuration": "Release",
    "tests": {
      "driver": "ctest/1"
    },
    "artifacts": [
      {
        "id": "atmos-http",
        "path": "build/sister-atmos-http",
        "executable": true
      },
      {
        "id": "atmos-cli",
        "path": "build/atmos-a0",
        "executable": true
      }
    ]
  },
  "runtime": {
    "schema": "sister.runtime/1.0.0",
    "entrypoint": "scripts/runtime.sh",
    "actions": [
      "start",
      "stop",
      "restart",
      "status",
      "health",
      "readiness"
    ],
    "state_policy": "stateless"
  },
  "interaction_surfaces": [
    {
      "surface_id": "atmos-precipitation",
      "label": "Atmos",
      "purpose": "Consultar e comparar precipitação em contexto territorial",
      "path": "/",
      "access_class": "research"
    }
  ]
}
